#!/usr/bin/env php
<?php

declare(strict_types=1);

// **JIT on, because this repository is a geometry solver wearing a console application.** The image ships opcache
// with a 64 MB JIT buffer and `opcache.jit` empty, which means off. `opcache.jit` is settable at runtime and the
// buffer is the part that is not, so one line here turns it on wherever the CLI runs, with no image or ddev config
// to keep in step. Measured on the default `scene:stack` sweep across 28 cores: **2m31s against 2m00s**, output
// byte-identical. Silenced because a build without opcache should run slowly rather than not at all.
@ini_set('opcache.jit', 'tracing');

require dirname(__DIR__).'/vendor/autoload.php';

use App\Command\BuildAllCommand;
use App\Command\CatalogCommand;
use App\Command\LibraryBuildCommand;
use App\Command\LoadPlanCommand;
use App\Command\ModelsBuildCommand;
use App\Command\SceneBuildCommand;
use App\Command\ScenePackCommand;
use App\Command\SceneRenderCommand;
use App\Command\SceneStackCommand;
use App\Command\SpecsValidateCommand;
use Symfony\Component\Console\Application;

// **The version is read from `composer.json` rather than written here.** It had been a literal since 0.65.0
// and was 31 releases stale by the time anybody looked, which is what a number duplicated between two files
// does. `composer.json` is the one this project's own convention bumps, so it is the one that decides.
$version = 'unknown';
$manifest = json_decode((string) @file_get_contents(dirname(__DIR__).'/composer.json'), true);
if (is_array($manifest) && is_string($manifest['version'] ?? null)) {
    $version = $manifest['version'];
}

$app = new Application('sdwa5-3d', $version);
$app->addCommands([
    new SpecsValidateCommand(),
    new ModelsBuildCommand(),
    new LibraryBuildCommand(),
    new SceneStackCommand(),
    new SceneBuildCommand(),
    new ScenePackCommand(),
    new SceneRenderCommand(),
    new CatalogCommand(),
    new LoadPlanCommand(),
    new BuildAllCommand(),
]);
$app->run();
