{
  "name": "sdwa5/sdwa5-3d",
  "description": "SdWa5 3D equipment library — spec-driven parametric 3D models of all SdWa5 speakers and stage equipment, for Blender event scene previews and setup planning",
  "version": "0.71.2",
  "type": "project",
  "homepage": "https://sdwa5.org",
  "require": {
    "php": ">=8.3",
    "symfony/console": "^7.0",
    "symfony/yaml": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3.0"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
