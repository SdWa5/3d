{
  "name": "sdwa5/sdwa5-3d",
  "description": "SdWa5 3D equipment library — spec-driven parametric 3D models of all SdWa5 speakers and stage equipment, for Blender event scene previews and setup planning",
  "version": "0.110.0",
  "type": "project",
  "homepage": "https://sdwa5.org",
  "require": {
    "php": ">=8.3",
    "symfony/console": "^7.0",
    "symfony/yaml": "^7.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3.0"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --no-progress",
    "cs": "php-cs-fixer fix --dry-run --diff --show-progress=none",
    "cs-fix": "php-cs-fixer fix --show-progress=none",
    "static": [
      "@stan",
      "@cs"
    ]
  }
}
