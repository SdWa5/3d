# Tooling caches and dependencies
/.claude/
/.php-cs-fixer.cache
/.phpunit.result.cache
/vendor/

# Generated models, asset library and renders — regenerate with `bin/console models:build`
/build/

# Blender leftovers
*.blend1
__pycache__/

# Override meshes referenced by mesh_override — third-party CAD, kept out of git. Only the README is committed
/meshes/*
!/meshes/README.md

# Local working material — reference images, screenshots, handoff notes and scratch sweeps stay on this machine
/.handoff/
/reference-files/
/*.png
/*.jpg
/*.jpeg
/scenes/generated/scratch-*/
